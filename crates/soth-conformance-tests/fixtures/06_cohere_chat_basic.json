{
  "name": "cohere_chat_basic",
  "description": "Cohere chat, single message, non-streaming.",
  "axes": {
    "provider": "cohere",
    "streaming": false,
    "tools": false,
    "content_class": "clean",
    "format": "rest_chat_completions",
    "capture_mode": "metadata_only"
